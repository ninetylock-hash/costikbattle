<!doctype html><html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%=caseData.name%> — Costik Battle</title><link rel="stylesheet" href="/style.css"></head><body>
<header><a class="logo" href="/">COSTIK <b>BATTLE</b></a><nav><a href="/">КЕЙСЫ</a><a href="/inventory">ИНВЕНТАРЬ</a><a href="/upgrade">АПГРЕЙД</a></nav><div class="header-user"><% if(user){ %><img class="avatar" src="<%=user.avatar%>"><b><%=user.display_name%></b> · <%=user.balance%> токенов<% }else{ %><a class="btn" href="/auth/steam">Войти через Steam</a><% } %></div></header>
<main><a class="back" href="/">← Все кейсы</a><section class="case-head case-head-premium"><div class="case-hero-art art-<%=caseData.art%>" data-art="<%=caseData.art%>"><span class="case-number">COSTIK DROP</span></div><div class="case-head-copy"><p class="eyebrow">MIXED DROP COLLECTION</p><h1><%=caseData.name%></h1><p>Открытие: <b><%=caseData.price.toLocaleString("ru-RU")%> токенов</b></p><div class="case-metrics"><div><b><%=caseData.items.length%></b><small>предметов</small></div><div><b><%=caseData.expectedValue.toLocaleString("ru-RU")%></b><small>EV токенов</small></div><div><b><%=Math.round(caseData.roi*100)%>%</b><small>возврат EV</small></div></div><p class="case-risk"><b><%=caseData.risk%></b> · Дроп от <%=Math.min(...caseData.items.map(x=>x.price)).toLocaleString("ru-RU")%> до <%=Math.max(...caseData.items.map(x=>x.price)).toLocaleString("ru-RU")%> токенов</p><button class="btn open" data-id="<%=caseData.id%>">ОТКРЫТЬ КЕЙС · <%=caseData.price%> TOKENS</button></div></section>
<div class="section-heading"><div><span class="eyebrow">36 УНИКАЛЬНЫХ ПОЗИЦИЙ</span><h2>Содержимое кейса</h2></div><div class="market-indicator"><i></i><span><%=marketStatus%></span></div></div>
<p class="note">Чем выше цена предмета относительно стоимости кейса, тем ниже вероятность его выпадения. В таблице показаны рыночные цены в токенах и точные шансы текущего дропа.</p>
<div class="drop-grid"><% caseData.items.forEach((x,i)=>{ %><article class="drop-card rarity-<%=i>=34?'jackpot':i>=30?'high':i>=22?'mid':'common'%>"><div class="skin-frame"><img data-skin="<%=x.name%>" alt="<%=x.name%>"><span class="skin-tier"><%=i>=34?'JACKPOT':i>=30?'RARE':i>=22?'PREMIUM':'DROP'%></span></div><h3><%=x.name%></h3><div class="skin-price"><b><%=x.price.toLocaleString("ru-RU")%></b><small>токенов</small></div><div class="drop-odds"><span>Шанс выпадения</span><b><%=x.probability.toFixed(2)%>%</b></div></article><% }) %></div></main>
<div id="modal" class="modal hide"><div class="dialog wide"><h2 id="roll-title">ОТКРЫТИЕ КЕЙСА</h2><div class="reel-wrap"><div class="reel-pointer"></div><div id="reel" class="reel"></div></div><h2 id="item-name"></h2><p id="item-price"></p><a class="btn" href="/inventory">Инвентарь</a><button id="close" class="btn">Закрыть</button></div></div><script src="/app.js"></script></body></html>